#!/usr/bin/env python3
"""
dp-auth: Universal Multi-Device & USB Optical Fingerprint Authentication Engine.
Coordinates Digital Persona U.are.U 4500 USB readers alongside any internal laptop sensors.

Features:
- Continuous Non-Stop Optical Illumination: Sensor stays illuminated and instantly re-arms on any scan
- Verified VerifyStop() -> VerifyStart() atomic state-machine cycle
- Dynamic USB reader hotplugging via Manager signals
- Live PAM conversation output
- Instant shutdown of sensors and LEDs upon match
"""

import sys
import os
import signal
import getpass
import glob
import gi

gi.require_version("Gio", "2.0")
gi.require_version("GLib", "2.0")
from gi.repository import Gio, GLib

FPRINT_SERVICE = "net.reactivated.Fprint"
MANAGER_PATH = "/net/reactivated/Fprint/Manager"
DEVICE_INTERFACE = "net.reactivated.Fprint.Device"


def get_target_user():
    if len(sys.argv) > 1 and sys.argv[1].strip():
        return sys.argv[1].strip()
    return os.environ.get("PAM_USER", os.environ.get("USER", getpass.getuser()))


def get_friendly_name(name: str, path: str) -> str:
    if "Digital" in name or "uru4000" in name or "4500" in name:
        return "Digital Persona USB Optical Reader"
    elif "Goodix" in name or "goodix" in name.lower() or "0" in path:
        return "Laptop Fingerprint Sensor"
    return f"{name} ({os.path.basename(path)})"


def is_optical_device(name: str) -> bool:
    name_lower = name.lower()
    return "digital" in name_lower or "uru4000" in name_lower or "4500" in name_lower or "4000" in name_lower or "optical" in name_lower


def is_internal_device(name: str, path: str) -> bool:
    """Identify onboard / laptop integrated sensors (e.g. Goodix, Synaptics, Elan)."""
    name_lower = name.lower()
    if any(k in name_lower for k in ("goodix", "synaptics", "elan", "focaltech", "internal")):
        return True
    return not is_optical_device(name)


def is_lid_closed() -> bool:
    """Detect if laptop lid is closed via ACPI button state or logind."""
    for p in glob.glob("/proc/acpi/button/lid/*/state"):
        try:
            with open(p, "r") as f:
                if "closed" in f.read().lower():
                    return True
        except Exception:
            pass
    try:
        bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
        logind = Gio.DBusProxy.new_sync(
            bus, Gio.DBusProxyFlags.NONE, None,
            "org.freedesktop.login1", "/org/freedesktop/login1",
            "org.freedesktop.DBus.Properties", None
        )
        val = logind.Get("(ss)", "org.freedesktop.login1.Manager", "LidClosed")
        if val and bool(val.unpack()):
            return True
    except Exception:
        pass
    return False


def main():
    username = get_target_user()
    timeout_sec = int(os.environ.get("DP_AUTH_TIMEOUT", "30"))

    try:
        bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
        manager = Gio.DBusProxy.new_sync(
            bus, Gio.DBusProxyFlags.NONE, None,
            FPRINT_SERVICE, MANAGER_PATH, "net.reactivated.Fprint.Manager", None
        )
        raw_device_paths = manager.GetDevices()
    except Exception as e:
        print(f"[DP-AUTH] D-Bus connection error: {e}", file=sys.stderr)
        sys.exit(2)

    if isinstance(raw_device_paths, (list, tuple)) and len(raw_device_paths) > 0 and isinstance(raw_device_paths[0], (list, tuple)):
        device_paths = list(raw_device_paths[0])
    elif isinstance(raw_device_paths, (list, tuple)):
        device_paths = list(raw_device_paths)
    else:
        device_paths = []

    loop = GLib.MainLoop()
    exit_code = [1]
    matched_finger = [""]
    active_devices = {}

    def disarm_device(path, release=True):
        if path in active_devices:
            dev_entry = active_devices[path]
            if dev_entry.get("rearm_timer") is not None:
                try:
                    GLib.source_remove(dev_entry["rearm_timer"])
                except Exception:
                    pass
                dev_entry["rearm_timer"] = None
            if release:
                try:
                    dev_entry["proxy"].VerifyStop()
                except Exception:
                    pass
                try:
                    dev_entry["proxy"].Release()
                except Exception:
                    pass
                try:
                    dev_entry["proxy"].disconnect(dev_entry["signal_id"])
                except Exception:
                    pass
            active_devices.pop(path, None)

    def cleanup():
        for path in list(active_devices.keys()):
            disarm_device(path, release=True)

    def handle_signal_terminate(signum, frame):
        cleanup()
        sys.exit(1)

    signal.signal(signal.SIGINT, handle_signal_terminate)
    signal.signal(signal.SIGTERM, handle_signal_terminate)

    def rearm_device(path):
        if path not in active_devices or exit_code[0] == 0:
            return False
        info = active_devices[path]
        proxy = info["proxy"]
        friendly = info["friendly"]
        optical = info["is_optical"]

        try:
            try:
                proxy.VerifyStop()
            except Exception:
                pass
            proxy.VerifyStart("(s)", "")
            info["is_verifying"] = True
            if optical:
                print(f"💡 {friendly} relit & ready for scan.", flush=True)
            return True
        except Exception:
            info["rearm_timer"] = GLib.timeout_add(80, lambda: rearm_device(path))
            return False

    def schedule_rearm(path):
        if path not in active_devices or exit_code[0] == 0:
            return
        info = active_devices[path]
        if info.get("rearm_timer") is not None:
            try:
                GLib.source_remove(info["rearm_timer"])
            except Exception:
                pass

        def on_rearm_timeout():
            info["rearm_timer"] = None
            rearm_device(path)
            return False

        info["rearm_timer"] = GLib.timeout_add(50, on_rearm_timeout)

    def on_device_signal(proxy, sender, signal_name, parameters, path):
        if path not in active_devices:
            return
        info = active_devices[path]
        friendly = info["friendly"]
        is_optical = info["is_optical"]

        if signal_name == "VerifyFingerSelected":
            f_name = parameters.unpack()[0]
            matched_finger[0] = f_name

        elif signal_name == "VerifyStatus":
            result, done = parameters.unpack()

            if result == "verify-match":
                f_str = matched_finger[0] or "enrolled print"
                print(f"✅ Fingerprint recognized on {friendly} ({f_str})! Authorized.", flush=True)
                exit_code[0] = 0
                cleanup()
                loop.quit()
                return

            elif result == "verify-no-match":
                print(f"⚠️ Fingerprint did not match on {friendly}. Sensor relit — try scanning again!", flush=True)

            elif result == "verify-retry-scan":
                hint = "press finger firmly flat against illuminated prism" if is_optical else "touch firmly"
                print(f"⚠️ Scan unclear on {friendly}. Please {hint}.", flush=True)

            elif result == "verify-swipe-too-short":
                print(f"⚠️ Swipe too short on {friendly}. Please swipe again smoothly.", flush=True)

            elif result == "verify-finger-not-centered":
                print(f"⚠️ Center your finger on {friendly}.", flush=True)

            elif result == "verify-remove-and-retry":
                print(f"⚠️ Lift finger completely from {friendly} and place it again.", flush=True)

            elif result == "verify-unknown-error":
                print(f"⚠️ Resetting {friendly} sensor...", flush=True)

            if done:
                info["is_verifying"] = False
                schedule_rearm(path)

    # Lid state inspection (Laptop lid closed / docked mode)
    lid_closed = is_lid_closed()
    if lid_closed:
        print("💻 Laptop lid is closed (docked mode) -> Bypassing keyboard sensor, arming external USB reader exclusively.", flush=True)

    # Initial device registration
    for path in device_paths:
        try:
            dev = Gio.DBusProxy.new_sync(
                bus, Gio.DBusProxyFlags.NONE, None,
                FPRINT_SERVICE, path, DEVICE_INTERFACE, None
            )
            name = dev.get_cached_property("name").get_string()

            # When laptop lid is closed, skip inaccessible onboard/keyboard sensors
            if lid_closed and is_internal_device(name, path):
                continue

            enrolled = dev.ListEnrolledFingers("(s)", username)
            if enrolled and len(enrolled) > 0:
                dev.Claim("(s)", username)
                sid = dev.connect("g-signal", on_device_signal, path)
                friendly = get_friendly_name(name, path)
                optical = is_optical_device(name)

                active_devices[path] = {
                    "proxy": dev,
                    "name": name,
                    "friendly": friendly,
                    "enrolled": list(enrolled),
                    "signal_id": sid,
                    "is_optical": optical,
                    "is_verifying": False,
                    "rearm_timer": None
                }
        except Exception:
            continue

    if not active_devices:
        if lid_closed:
            print("💻 Laptop lid is closed and no external USB fingerprint reader is connected. Falling back to password/face ID.", flush=True)
        sys.exit(2)

    # Initial arming
    for path in list(active_devices.keys()):
        try:
            active_devices[path]["proxy"].VerifyStart("(s)", "")
            active_devices[path]["is_verifying"] = True
        except Exception:
            rearm_device(path)

    # Prompt header
    print(f"Touch any fingerprint reader ({len(active_devices)} active):", flush=True)
    for path, info in active_devices.items():
        fingers_fmt = ", ".join(info["enrolled"])
        print(f"  • {info['friendly']}: {len(info['enrolled'])} enrolled ({fingers_fmt})", flush=True)

    # Hotplug Listener via Manager
    def on_manager_signal(proxy, sender, signal_name, parameters):
        if signal_name == "DeviceAdded":
            new_path = parameters.unpack()[0]
            if new_path not in active_devices:
                try:
                    new_dev = Gio.DBusProxy.new_sync(
                        bus, Gio.DBusProxyFlags.NONE, None,
                        FPRINT_SERVICE, new_path, DEVICE_INTERFACE, None
                    )
                    new_name = new_dev.get_cached_property("name").get_string()

                    # Ignore internal sensors hotplug if lid is closed
                    if is_lid_closed() and is_internal_device(new_name, new_path):
                        return

                    new_enrolled = new_dev.ListEnrolledFingers("(s)", username)
                    if new_enrolled and len(new_enrolled) > 0:
                        new_dev.Claim("(s)", username)
                        sid = new_dev.connect("g-signal", on_device_signal, new_path)
                        friendly = get_friendly_name(new_name, new_path)
                        optical = is_optical_device(new_name)

                        active_devices[new_path] = {
                            "proxy": new_dev,
                            "name": new_name,
                            "friendly": friendly,
                            "enrolled": list(new_enrolled),
                            "signal_id": sid,
                            "is_optical": optical,
                            "is_verifying": False,
                            "rearm_timer": None
                        }
                        rearm_device(new_path)
                        print(f"🔌 Sensor connected & armed: {friendly} ({len(new_enrolled)} prints)", flush=True)
                except Exception:
                    pass
        elif signal_name == "DeviceRemoved":
            removed_path = parameters.unpack()[0]
            if removed_path in active_devices:
                friendly = active_devices[removed_path]["friendly"]
                disarm_device(removed_path, release=False)
                print(f"🔌 Sensor disconnected: {friendly}", flush=True)

    try:
        manager.connect("g-signal", on_manager_signal)
    except Exception:
        pass

    def on_timeout():
        cleanup()
        loop.quit()
        return False

    GLib.timeout_add_seconds(timeout_sec, on_timeout)

    try:
        loop.run()
    except Exception:
        cleanup()
        sys.exit(1)

    sys.exit(exit_code[0])


if __name__ == "__main__":
    main()
